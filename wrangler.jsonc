{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gumnaam",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  // Static build output (client JS/CSS/images) served directly by Cloudflare's asset layer
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  // Public/build-time values (VITE_ vars are already inlined into the client bundle at build
  // time — these are only for anything the server bundle reads via process.env at runtime).
  "vars": {
    "SUPABASE_URL": "https://ofbemkznkyodupabmhof.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4Blfqjvix_Z7HB12GUhmCw_ITple3Mx"
  }

  // Secrets — do NOT put these here. Set them via:
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // (used server-side only, in src/integrations/supabase/client.server.ts)
}